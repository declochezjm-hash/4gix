#! FME Workspace File
#! Sample 4GIx — GeometryValidator → Tester → PostGISWriter
#! NAME "4GIx FME Demo"
#! <WORKSPACE FORMAT="1.0" ENCODING="UTF-8">
#!   <TRANSFORMER_LIST>
#!     <TRANSFORMER IDENTIFIER="1" INSTANCENAME="GeoJSON Reader" TYPE="OGRGeoJSON" POSITION="80,160"/>
#!     <TRANSFORMER IDENTIFIER="2" INSTANCENAME="GeometryValidator" TYPE="GeometryValidator" POSITION="320,160"/>
#!     <TRANSFORMER IDENTIFIER="3" INSTANCENAME="Tester" TYPE="Tester" POSITION="560,80"/>
#!     <TRANSFORMER IDENTIFIER="4" INSTANCENAME="Log Writer" TYPE="LogWriter" POSITION="560,280"/>
#!     <TRANSFORMER IDENTIFIER="5" INSTANCENAME="PostGIS Writer" TYPE="PostGISWriter" POSITION="820,80"/>
#!   </TRANSFORMER_LIST>
#!   <LINK_LIST>
#!     <LINK SOURCE="1" SOURCE_PORT="OUTPUT" TARGET="2" TARGET_PORT="INPUT"/>
#!     <LINK SOURCE="2" SOURCE_PORT="OUTPUT" TARGET="3" TARGET_PORT="INPUT"/>
#!     <LINK SOURCE="2" SOURCE_PORT="REJECTED" TARGET="4" TARGET_PORT="INPUT"/>
#!     <LINK SOURCE="3" SOURCE_PORT="PASSED" TARGET="5" TARGET_PORT="INPUT"/>
#!   </LINK_LIST>
#! </WORKSPACE>
